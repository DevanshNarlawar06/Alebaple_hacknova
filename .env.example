# ============================================================
# Disaster Information Verification System — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- LLM API ---
# Google Gemini Flash (recommended for hackathon)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI (if using GPT-4o instead)
# OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Groq (if using Llama-3 instead)
# GROQ_API_KEY=your_groq_api_key_here

# --- GDACS ---
# Public RSS/GeoJSON feed requires no key.
# Authenticated API (optional, higher rate limits):
GDACS_API_KEY=

# --- ReliefWeb ---
# Public API requires no key for basic access.
# Optional app name for API identification:
RELIEFWEB_APP_NAME=disaster_verification_hacknova26

# --- Nominatim / OpenStreetMap Geocoding ---
# Public API — no key required.
# Set a descriptive user-agent as required by OSM usage policy:
NOMINATIM_USER_AGENT=disaster_verification_hacknova26/1.0

# --- Database ---
SQLITE_DB_PATH=data/db/evidence.db
CHROMA_DB_PATH=data/db/chroma

# --- Dataset Paths ---
RAW_DATA_DIR=dataset/raw
PROCESSED_DATA_DIR=dataset/processed
SYNTHETIC_DATA_DIR=dataset/synthetic
GROUND_TRUTH_DIR=dataset/ground_truth
BENCHMARK_DIR=dataset/benchmark

# --- Workflow ---
SCHEMA_VERSION=0.1
